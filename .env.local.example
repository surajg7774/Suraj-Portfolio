# Copy this file to .env.local and fill in your own EmailJS credentials.
# Create a free account at https://www.emailjs.com/ to get these values —
# they are NOT committed anywhere in this repo.
#
# These are all NEXT_PUBLIC_ variables because EmailJS is designed to run
# entirely client-side using a public key (no server secret required).

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
